# Database
DATABASE_URL=postgresql://user:password@localhost:5432/delo

# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=

# Email
EMAIL_FROM="Delo <noreply@delo.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_DOMAIN=yourdomain.com

# App
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3
S3_REGION=us-east-1
S3_BUCKET=delo-uploads
S3_ACCESS_KEY_ID=delo_minio
S3_SECRET_ACCESS_KEY=delo_minio_password
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# MinIO Docker
MINIO_ROOT_USER=delo_minio
MINIO_ROOT_PASSWORD=delo_minio_password
